# Copy ke .env dan isi nilai sebenarnya.
# Jangan commit file .env ke git.

IRC_DB_HOST=127.0.0.1
IRC_DB_PORT=3306
IRC_DB_NAME=irc_chat
IRC_DB_USER=irc_app
IRC_DB_PASS=GantiDenganPasswordKuatDiSini

# Generate: openssl rand -hex 32
IRC_DB_KEY=ganti_dengan_64_hex_chars_dari_openssl_rand_hex_32

IRC_WS_HOST=0.0.0.0
IRC_WS_PORT=8090
